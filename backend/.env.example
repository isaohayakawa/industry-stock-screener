# Copy this file to .env and fill in your real key.
# .env is gitignored and should never be committed.
FMP_API_KEY=your_api_key_here

# How many hours before cached data is considered stale
CACHE_STALE_HOURS=24

# Optional: enables the AI summary blurb on each screen.
# Get a key at https://platform.claude.com - leave blank to hide the blurbs.
ANTHROPIC_API_KEY=
